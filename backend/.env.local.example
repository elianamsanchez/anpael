# =====================================================================
# VARIABLES DE ENTORNO · LOCAL (Supabase en Docker) · copiar a .env y completar
# =====================================================================
# .env esta en .gitignore. NUNCA lo subas al repo.
#
# Apunta al Supabase que corre en tu maquina con Docker, con el dump de la
# base productiva ya cargado adentro. Es una base DISTINTA de la real: lo
# que escribas, corrijas o borres aca no toca produccion, y viceversa. Como
# tiene el mismo dump, va a devolver la misma cantidad de animales que
# produccion — la forma de no confundirlas es el campo "entorno" de abajo,
# que /api/health devuelve tal cual.
#
# Completa host, puerto, usuario, base y contraseña con lo que tenga TU
# instancia local (por ejemplo, la salida de `supabase status`, o tu
# docker-compose si la armaste a mano). No copies estos valores de memoria:
# son solo el default mas comun del CLI de Supabase, pueden no ser los tuyos
# si cambiaste algo en supabase/config.toml.
#
# NO lleva ?prepareThreshold=0: eso es especifico del pooler en modo
# transaccion de la nube (puerto 6543 de produccion). Local te conectas
# directo al Postgres del contenedor, sin pooler de por medio, asi que los
# prepared statements con nombre no dan problema.
# =====================================================================

ANPAEL_ENTORNO=local

ANPAEL_DB_URL=jdbc:postgresql://127.0.0.1:54322/postgres
ANPAEL_DB_USER=postgres
ANPAEL_DB_PASSWORD=postgres

ANPAEL_PORT=8080
ANPAEL_CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Acá no hay nada real que proteger: podes dejar cualquier valor largo.
# Lo unico que importa es que NUNCA sea la misma clave que la de produccion.
ANPAEL_JWT_SECRETO=clave-de-desarrollo-local-nunca-usar-en-produccion
ANPAEL_JWT_MINUTOS=480

# En local conviéne DEBUG: es la base de prueba, no hay costo en ver el SQL.
ANPAEL_LOG_SQL=DEBUG
