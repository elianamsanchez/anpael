# =====================================================================
# VARIABLES DE ENTORNO · PRODUCCION · copiar a .env y completar
# =====================================================================
# .env esta en .gitignore. NUNCA lo subas al repo.
#
# Esta es la base real de Santa Ana: 1.732 animales migrados y en uso.
# Si tenes dudas sobre si esto es lo que queres correr, pregunta ANTES de
# ejecutar algo que escriba en la base. Para desarrollo del dia a dia usa
# .env.local.example, no este.
#
# De donde sale cada valor, en Supabase:
#   Project Settings -> Database -> Connection string -> "Transaction pooler"
# Esa pantalla te da la URL, el usuario y el puerto. La contraseña es la que
# pusiste al crear el proyecto (si no la recordas, se resetea ahi mismo).
#
# OJO con el ?prepareThreshold=0 del final: es obligatorio con el pooler en
# modo transaccion. Sin eso el driver de PostgreSQL usa prepared statements
# con nombre y el pooler los rechaza de forma intermitente.
# =====================================================================

# Se refleja en /api/health como "entorno", para no confundirla con local
# aunque las dos tengan la misma cantidad de animales.
ANPAEL_ENTORNO=produccion

ANPAEL_DB_URL=jdbc:postgresql://aws-0-sa-east-1.pooler.supabase.com:6543/postgres?prepareThreshold=0&sslmode=require
ANPAEL_DB_USER=postgres.abcdefghijklmnop
ANPAEL_DB_PASSWORD=

ANPAEL_PORT=8080
ANPAEL_CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Generar una clave larga y distinta por entorno, por ejemplo con:
#   openssl rand -base64 48
# NUNCA la misma que uses en .env.local.
ANPAEL_JWT_SECRETO=
ANPAEL_JWT_MINUTOS=480

# Poner en DEBUG para ver el SQL que genera Hibernate
ANPAEL_LOG_SQL=WARN
