{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/avisos/**",
              "components/base/**",
              "components/datos/**",
              "components/formularios/**",
              "ui_kits/anpael-campo/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Instrument Serif|Karla|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Instrument Serif, Karla, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aviso'] > JSXAttribute > JSXIdentifier[name!=/^(?:tono|detalle|children|style|key|ref|className|style|children)$/]",
        "message": "<Aviso> doesn't accept that prop. Declared props: tono, detalle, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Aviso'] > JSXAttribute[name.name='tono'] > Literal[value!=/^(?:ok|error|atencion|info)$/]",
        "message": "<Aviso> tono must be one of 'ok' | 'error' | 'atencion' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute > JSXIdentifier[name!=/^(?:variante|tamano|ancho|deshabilitado|tipo|onClick|children|style|key|ref|className|style|children)$/]",
        "message": "<Boton> doesn't accept that prop. Declared props: variante, tamano, ancho, deshabilitado, tipo, onClick, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='variante'] > Literal[value!=/^(?:primario|acento|sobrio|texto)$/]",
        "message": "<Boton> variante must be one of 'primario' | 'acento' | 'sobrio' | 'texto'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='tamano'] > Literal[value!=/^(?:md|sm)$/]",
        "message": "<Boton> tamano must be one of 'md' | 'sm'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Boton'] > JSXAttribute[name.name='tipo'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Boton> tipo must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Buscador'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|onChange|placeholder|ancho|style|key|ref|className|style|children)$/]",
        "message": "<Buscador> doesn't accept that prop. Declared props: valor, onChange, placeholder, ancho, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='OpcionCampo'] > JSXAttribute > JSXIdentifier[name!=/^(?:valor|etiqueta|key|ref|className|style|children)$/]",
        "message": "<OpcionCampo> doesn't accept that prop. Declared props: valor, etiqueta."
      },
      {
        "selector": "JSXOpeningElement[name.name='Check'] > JSXAttribute > JSXIdentifier[name!=/^(?:etiqueta|marcado|onChange|deshabilitado|style|key|ref|className|style|children)$/]",
        "message": "<Check> doesn't accept that prop. Declared props: etiqueta, marcado, onChange, deshabilitado, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etiqueta'] > JSXAttribute > JSXIdentifier[name!=/^(?:tono|capsula|children|style|key|ref|className|style|children)$/]",
        "message": "<Etiqueta> doesn't accept that prop. Declared props: tono, capsula, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Etiqueta'] > JSXAttribute[name.name='tono'] > Literal[value!=/^(?:falta|tipo|ok|mal|atenuado)$/]",
        "message": "<Etiqueta> tono must be one of 'falta' | 'tipo' | 'ok' | 'mal' | 'atenuado'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemHistorial'] > JSXAttribute > JSXIdentifier[name!=/^(?:fecha|tipo|detalle|comentario|ultimo|children|style|key|ref|className|style|children)$/]",
        "message": "<ItemHistorial> doesn't accept that prop. Declared props: fecha, tipo, detalle, comentario, ultimo, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ItemDato'] > JSXAttribute > JSXIdentifier[name!=/^(?:rotulo|valor|numerico|key|ref|className|style|children)$/]",
        "message": "<ItemDato> doesn't accept that prop. Declared props: rotulo, valor, numerico."
      },
      {
        "selector": "JSXOpeningElement[name.name='Marca'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|bajada|punto|logo|logoSrc|children|style|key|ref|className|style|children)$/]",
        "message": "<Marca> doesn't accept that prop. Declared props: titulo, bajada, punto, logo, logoSrc, children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Paginado'] > JSXAttribute > JSXIdentifier[name!=/^(?:pagina|totalPaginas|onCambio|style|key|ref|className|style|children)$/]",
        "message": "<Paginado> doesn't accept that prop. Declared props: pagina, totalPaginas, onCambio, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnaTabla'] > JSXAttribute > JSXIdentifier[name!=/^(?:clave|titulo|alDerecha|numerico|render|key|ref|className|style|children)$/]",
        "message": "<ColumnaTabla> doesn't accept that prop. Declared props: clave, titulo, alDerecha, numerico, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tarjeta'] > JSXAttribute > JSXIdentifier[name!=/^(?:titulo|nota|denso|children|style|key|ref|className|style|children)$/]",
        "message": "<Tarjeta> doesn't accept that prop. Declared props: titulo, nota, denso, children, style."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
